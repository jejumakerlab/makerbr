# Supabase (Project URL만 넣으세요. /rest/v1 경로는 붙이지 않습니다)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# PortOne V2 (Toss Payments 등 채널 연동)
NEXT_PUBLIC_PORTONE_STORE_ID=store-xxxxx
NEXT_PUBLIC_PORTONE_CHANNEL_KEY=channel-key-xxxxx
PORTONE_API_SECRET=your-portone-api-secret

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
